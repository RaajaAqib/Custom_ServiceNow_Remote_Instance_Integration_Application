        <script><![CDATA[(function executeRule(current, previous) {
    // Newest comment comes with a header line "date - user (Additional comments)"; remove it
    var entry = current.comments.getJournalEntry(1);
    var comment = entry.replace(/^.*\r?\n/, '');
    if (!comment) {
        return;
    }
    // Start the integration Subflow asynchronously so the agent's save is never slowed down
    sn_fd.FlowAPI.getRunner()
        .subflow('x_1664823_remote_0.remote_sync_send_comment')
        .inBackground()
        .withInputs({ incident: current, comment: comment })
        .run();
})(current, previous);]]></script>
